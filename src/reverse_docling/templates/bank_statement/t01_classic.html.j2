{% extends "_base/base.html.j2" %}
{% set s = doc._style %}
{% block style %}
body { font-family: 'Noto Serif', Georgia, {{ font_stack | safe }}; }
.head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #222; padding-bottom: 8px; }
.bank { display: flex; gap: 10px; align-items: center; }
.bank h1 { margin: 0; font-size: 16pt; }
.title { text-align: end; }
.title h2 { margin: 0; font-size: 13pt; text-transform: uppercase; letter-spacing: .5px; }
.boxes { display: grid; grid-template-columns: 1.2fr 1fr; gap: 12px; margin: 14px 0; }
.box { border: 1px solid #999; padding: 8px 10px; }
.box h3 { margin: 0 0 4px; font-size: 9pt; text-transform: uppercase; color: #444; }
.kv td { padding: 1px 0; }
.kv td:first-child { color: #555; padding-inline-end: 10px; white-space: nowrap; }
.tx th { border-top: 1px solid #222; border-bottom: 1px solid #222; padding: 4px; font-size: 8.5pt; }
.tx td { padding: 3px 4px; border-bottom: 1px dotted #bbb; font-size: 8.5pt; }
.summary { margin-top: 12px; width: 55%; margin-inline-start: auto; }
.summary td { padding: 3px 6px; border-bottom: 1px solid #ddd; }
.summary tr:last-child td { font-weight: bold; border-top: 2px solid #222; }
.legal { margin-top: 18px; font-size: 7.5pt; color: #555; border-top: 1px solid #ccc; padding-top: 6px; }
{% endblock %}
{% block body %}
<div class="head">
  <div class="bank">{{ s.logo }}<div><h1>{{ doc.bank_name }}</h1>
    <div class="small muted">{{ t('bank_statement.branch') }}: {{ doc.branch }} · {{ doc.branch_code }}</div></div></div>
  <div class="title"><h2>{{ t('bank_statement.title') }}</h2>
    <div class="small">{{ t('bank_statement.statement_no') }} {{ doc.statement_number }}</div>
    <div class="small">{{ t('common.issue_date') }}: {{ fmt.date(doc.statement_date) }}</div></div>
</div>

<div class="boxes">
  <div class="box">
    <h3>{{ t('bank_statement.account_holder') }}</h3>
    <div><strong>{{ person.full_name }}</strong></div>
    <div>{{ person.address.street }} {{ person.address.building_number }}</div>
    <div>{{ person.address.postcode }} {{ person.address.city }}</div>
    <div>{{ person.address.state }}, {{ person.address.country }}</div>
  </div>
  <div class="box">
    <table class="kv">
      <tr><td>{{ t('bank_statement.account_number') }}</td><td><span class="ltr">{{ doc.account_number }}</span></td></tr>
      {% if doc.iban %}<tr><td>IBAN</td><td><span class="ltr">{{ doc.iban }}</span></td></tr>{% endif %}
      <tr><td>BIC/SWIFT</td><td><span class="ltr">{{ doc.bank_bic }}</span></td></tr>
      <tr><td>{{ t('bank_statement.account_type') }}</td><td>{{ doc.account_type }}</td></tr>
      <tr><td>{{ t('bank_statement.period') }}</td><td>{{ fmt.date(doc.period_start, 'short') }} – {{ fmt.date(doc.period_end, 'short') }}</td></tr>
      <tr><td>{{ t('common.currency') }}</td><td>{{ doc.currency }}</td></tr>
    </table>
  </div>
</div>

<table class="tx">
  <thead><tr>
    <th>{{ t('common.date') }}</th><th>{{ t('common.description') }}</th><th>{{ t('bank_statement.reference') }}</th>
    <th class="num">{{ t('bank_statement.debit') }}</th><th class="num">{{ t('bank_statement.credit') }}</th>
    <th class="num">{{ t('bank_statement.balance') }}</th></tr></thead>
  <tbody>
    <tr><td>{{ fmt.date(doc.period_start, 'short') }}</td><td colspan="4"><em>{{ t('bank_statement.opening_balance') }}</em></td>
      <td class="num">{{ fmt.money(doc.opening_balance, symbol=False) }}</td></tr>
    {% for tx in doc.transactions %}
    <tr><td class="nowrap">{{ fmt.date(tx.date, 'short') }}</td><td>{{ tx.description }}</td><td class="small muted">{{ tx.reference }}</td>
      <td class="num">{{ fmt.money(tx.debit, symbol=False) if tx.debit else '' }}</td>
      <td class="num">{{ fmt.money(tx.credit, symbol=False) if tx.credit else '' }}</td>
      <td class="num">{{ fmt.money(tx.balance, symbol=False) }}</td></tr>
    {% endfor %}
  </tbody>
</table>

<table class="summary">
  <tr><td>{{ t('bank_statement.opening_balance') }}</td><td class="num">{{ fmt.money(doc.opening_balance) }}</td></tr>
  <tr><td>{{ t('bank_statement.total_credits') }}</td><td class="num">{{ fmt.money(doc.total_credit) }}</td></tr>
  <tr><td>{{ t('bank_statement.total_debits') }}</td><td class="num">{{ fmt.money(doc.total_debit) }}</td></tr>
  <tr><td>{{ t('bank_statement.closing_balance') }}</td><td class="num">{{ fmt.money(doc.closing_balance) }}</td></tr>
</table>

<div class="legal">{{ t('bank_statement.legal') }}</div>
{% endblock %}
