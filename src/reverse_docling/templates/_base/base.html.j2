<!doctype html>
<html lang="{{ lang.code }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
{% block meta %}{% endblock %}
<style>
{{ fonts_css | safe }}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: {{ font_stack | safe }};
  font-size: 9.5pt;
  color: #1a1a1a;
  line-height: 1.35;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
table { border-collapse: collapse; width: 100%; }
th, td { text-align: start; vertical-align: top; }
.num { text-align: end; white-space: nowrap; font-variant-numeric: tabular-nums; }
.muted { color: #666; }
.small { font-size: 8pt; }
.nowrap { white-space: nowrap; }
.ltr { direction: ltr; unicode-bidi: isolate; }
td.ltr { text-align: start; }
thead { display: table-header-group; }
tr { break-inside: avoid; }
.specimen {
  position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 90pt; font-weight: 800; color: rgba(200, 0, 0, .08); transform: rotate(-30deg);
  pointer-events: none; z-index: 1000; font-family: sans-serif;
}
{% block style %}{% endblock %}
</style>
</head>
<body>
{% if specimen %}<div class="specimen">SPECIMEN</div>{% endif %}
{% block body %}{% endblock %}
</body>
</html>
