{% extends "_base/base.html.j2" %}
{% set s = doc._style %}
{% block style %}
.hd { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 26px; }
.hd h1 { font-size: 28pt; margin: 0; font-weight: 300; letter-spacing: 2px; color: {{ s.primary }}; text-transform: uppercase; }
.seller { text-align: end; }
.seller b { font-size: 12pt; }
.parties { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
.parties .l { font-size: 7.5pt; text-transform: uppercase; color: #888; margin-bottom: 3px; }
.meta td { padding: 2px 0; } .meta td:first-child { color: #777; padding-inline-end: 14px; }
.items th { border-bottom: 2px solid {{ s.primary }}; padding: 6px; font-size: 8pt; text-transform: uppercase; color: #555; }
.items td { padding: 8px 6px; border-bottom: 1px solid #eee; }
.tot { width: 45%; margin-inline-start: auto; margin-top: 10px; }
.tot td { padding: 4px 6px; }
.tot tr.g td { font-size: 13pt; font-weight: 700; border-top: 2px solid {{ s.primary }}; color: {{ s.primary }}; }
.stamp { display: inline-block; border: 3px solid #15803d; color: #15803d; font-weight: 800; padding: 2px 10px; transform: rotate(-8deg); font-size: 14pt; text-transform: uppercase; }
.pay { margin-top: 26px; font-size: 8.5pt; background: {{ s.light }}; padding: 10px 12px; }
.thanks { margin-top: 20px; text-align: center; color: #888; }
{% endblock %}
{% block body %}
<div class="hd">
  <div>{{ s.logo }}<h1>{{ t('invoice.title') }}</h1></div>
  <div class="seller"><b>{{ doc.seller }}</b><br>{{ doc.seller_address }}<br><span class="ltr">{{ doc.seller_email }}</span><br>
    {{ t('invoice.tax_id') }}: <span class="ltr">{{ doc.seller_tax_id }}</span></div>
</div>
<div class="parties">
  <div><div class="l">{{ t('invoice.bill_to') }}</div><strong>{{ doc.buyer_name }}</strong><br>{{ doc.buyer_address }}<br><span class="ltr">{{ doc.buyer_email }}</span></div>
  <div><table class="meta">
    <tr><td>{{ t('invoice.invoice_number') }}</td><td class="ltr"><strong>{{ doc.invoice_number }}</strong></td></tr>
    <tr><td>{{ t('invoice.order_number') }}</td><td class="ltr">{{ doc.order_number }}</td></tr>
    <tr><td>{{ t('common.issue_date') }}</td><td>{{ fmt.date(doc.issue_date) }}</td></tr>
    <tr><td>{{ t('common.due_date') }}</td><td>{{ fmt.date(doc.due_date) }}</td></tr>
  </table>{% if doc.paid %}<div class="stamp">{{ t('common.paid') }}</div>{% endif %}</div>
</div>
<table class="items">
  <thead><tr><th>{{ t('invoice.item') }}</th><th class="num">{{ t('common.quantity') }}</th><th class="num">{{ t('common.unit_price') }}</th><th class="num">{{ t('common.amount') }}</th></tr></thead>
  <tbody>{% for it in doc.line_items %}<tr><td>{{ it.description }}</td><td class="num">{{ it.quantity }}</td><td class="num">{{ fmt.money(it.unit_price) }}</td><td class="num">{{ fmt.money(it.amount) }}</td></tr>{% endfor %}</tbody>
</table>
<table class="tot">
  <tr><td>{{ t('common.subtotal') }}</td><td class="num">{{ fmt.money(doc.subtotal) }}</td></tr>
  {% if doc.discount %}<tr><td>{{ t('common.discount') }}</td><td class="num">−{{ fmt.money(doc.discount) }}</td></tr>{% endif %}
  <tr><td>{{ t('common.tax') }} ({{ fmt.number(doc.tax_rate * 100) }}%)</td><td class="num">{{ fmt.money(doc.tax) }}</td></tr>
  <tr class="g"><td>{{ t('common.total') }}</td><td class="num">{{ fmt.money(doc.total) }}</td></tr>
</table>
<div class="pay"><strong>{{ t('invoice.payment_details') }}</strong><br>{{ t('invoice.bank_transfer') }}: {{ doc.seller }} · <span class="ltr">{{ doc.seller_iban }}</span> · {{ t('common.reference') }}: <span class="ltr">{{ doc.invoice_number }}</span></div>
<div class="thanks">{{ t('invoice.thanks') }}</div>
{% endblock %}
